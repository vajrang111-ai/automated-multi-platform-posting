# ============================================================
# Automated Multi-Platform Posting System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# The .env file is excluded from version control (.gitignore).

# ---- GitHub Gist ----
# Personal Access Token with 'gist' scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# ---- HuggingFace ----
# API Token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here

# ---- App Settings (optional) ----
APP_HOST=0.0.0.0
APP_PORT=4000
